# ── Supabase ──────────────────────────────────────────────────────────────────
# Si vides, l'app utilise la couche mock (localStorage) au lieu de Supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ── Événement ─────────────────────────────────────────────────────────────────
# Préfixe de toutes les tables Supabase. Chaque événement a le sien.
VITE_TABLE_PREFIX=_20260725_

# Nom affiché dans l'app.
VITE_EVENT_NAME=Fiançailles de Sarah & Jordan

# Date principale de l'événement (format ISO YYYY-MM-DD).
VITE_EVENT_DATE=2026-07-25

# Dates d'installation et de désinstallation (optionnel — calculées ±1j si absentes).
# VITE_INSTALLATION_DATE=2026-07-24
# VITE_DESINSTALLATION_DATE=2026-07-26
